# Copia este archivo a ".env" (mismo nivel, junto a package.json) y completa
# los dos valores. Los sacas del panel de Supabase: tu proyecto → Settings →
# API. Usa la "anon public" key — NUNCA la "service_role" (esa es secreta y
# no debe usarse dentro de la app).
#
# Sin este archivo la app sigue funcionando en "modo demo" (datos de
# ejemplo, sin cuentas reales).

EXPO_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-publica
