# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Telegram
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# Chat IDs de administradores, separados por coma. Reciben avisos y pueden
# usar los comandos /resumen, /convocar, etc. en el bot.
ADMIN_CHAT_IDS=

# Opcional: zona horaria para mostrar fechas (por defecto America/Lima)
APP_TIMEZONE=America/Lima
