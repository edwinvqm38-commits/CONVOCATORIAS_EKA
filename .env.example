# Estas variables solo se usan para los scripts OPCIONALES en Python
# (scripts/, main.py) — crear/enviar convocatorias desde la terminal o cron
# en vez del chat. El bot en sí corre en Google Apps Script y NO usa este
# archivo: sus credenciales van en "Script properties" dentro del propio
# proyecto de Apps Script (ver README).

# Telegram
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# Google Sheets
# JSON completo (o el mismo JSON en base64) de una cuenta de servicio de
# Google con acceso a la API de Sheets. Comparte cada spreadsheet con el
# "client_email" de esta cuenta de servicio (como editor).
GOOGLE_SERVICE_ACCOUNT_JSON=

# ID del Google Sheet "de control": guarda usuarios registrados, sesiones de
# conversacion, especialidades y cual es la hoja activa. Es fijo, no cambia
# con /hoja (ese comando solo cambia donde se guardan convocatorias y
# respuestas). Se crea una vez a mano y se comparte con la cuenta de servicio.
GOOGLE_SHEETS_CONTROL_ID=

# Opcional: zona horaria para mostrar fechas (por defecto America/Lima)
APP_TIMEZONE=America/Lima
