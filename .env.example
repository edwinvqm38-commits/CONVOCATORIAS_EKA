# Estas variables solo se usan para el script opcional en Python
# (scripts/exportar_respuestas_sheets.py), corrido desde tu terminal o desde
# el workflow de GitHub Actions "Convocatorias - Exportar respuestas a
# Sheets". El bot en sí corre como una Edge Function de Supabase (Deno) y NO
# usa este archivo: sus variables se configuran como "Function secrets" en
# el proyecto de Supabase (ver README).

# Cuenta de servicio de Google con acceso a la API de Sheets: JSON completo
# (o el mismo JSON en base64). Comparte el spreadsheet destino con su
# "client_email" (como editor).
GOOGLE_SERVICE_ACCOUNT_JSON=

# URL y service_role key del proyecto Supabase OFICINA_IA (Project Settings
# -> API). La service_role key ignora RLS: no la expongas fuera de scripts
# de servidor / GitHub Actions.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ID del Google Sheet donde se vuelca la exportacion (el de la URL, entre
# /d/ y /edit).
GOOGLE_SHEETS_EXPORT_ID=
